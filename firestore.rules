rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{document=**} {
      allow read: if true;
      allow write: if true; // Insecure for fast prototyping, ideally use if request.auth != null;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
